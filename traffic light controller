module traffic_light_controller(input clk,rst,output reg [1:0]ns_out,ew_out,output reg [2:0]count);
parameter all_red=3'b000;
parameter ns_red=3'b001;
parameter ns_yellow=3'b010;
parameter ns_green=3'b011;
parameter ew_red=3'b100;
parameter  ew_yellow=3'b101;
parameter ew_green=3'b110;
reg [2:0]ps,ns;
always@(posedge clk)
begin
if(rst)begin
ps<=all_red;
count<=0;
end
else if(count<8)begin
count<=count+1'b1;
ps<=ns;
end
else if(count>7)
count<=0;
end

always@(*)
begin
case(ps)
all_red:begin
         if(count==2)
         ns=ns_red;
         else
         ns=all_red;
         
         end
ns_red: begin
        if(count==4)
        ns=ns_yellow;
        else
        ns=ns_red;
        end
ns_yellow: begin
           if(count==2)
           ns=ns_green;
           else
           ns=ns_yellow;
           end
ns_green:begin
           if(count==7)
           ns=ew_red;
           else
           ns=ns_green;
           end
ew_red: begin
        if(count==4)
        ns=ew_yellow;
        else
        ns=ew_red;
        end
ew_yellow: begin
           if(count==2)
           ns=ew_green;
           else
           ns=ew_yellow;
           end
ew_green:begin
           if(count==7)
           ns=ns_red;
           else
           ns=ew_green;
           end
            
endcase
end
always@(*)
begin
case(ps)
//2'b00=stop;
//2'b01=wait;
//2'b11=start;
all_red:begin
        ns_out=2'b00;
        ew_out=2'b00;
        end
ns_red:begin
       ns_out=2'b00;
       ew_out=2'b01;
       end
ns_yellow:begin
          ns_out=2'b01;
          ew_out=2'b11;
          end
ns_green:begin
          ns_out=2'b11;
          ew_out=2'b01;
          end
ew_red:begin
       ns_out=2'b01;
       ew_out=2'b00;
       end
ew_yellow:begin
          ns_out=2'b00;
          ew_out=2'b01;
          end
ew_green:begin
          ns_out=2'b01;
          ew_out=2'b11;
          end
         endcase
end
endmodule


